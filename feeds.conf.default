# miniupnpd 修复：immortalwrt/packages 的 dd29469（2026-10-16）升到 2.3.11 却留下
# 2.3.9 的 020/030/040 旧补丁，打不上导致编译失败；上游 PR #2001 已给出修复但未合并。
# 固定到该 PR 的 head 11ebc02d（naoki66/packages，父提交即当前 master 8d50d4ea）：
# 保留 2.3.11，删除 020/030、刷新 040；PR 合并后改回 immortalwrt/packages 并去掉 ^commit。
# 已存在的 feeds/packages 不会自动切到固定提交，需先 rm -rf feeds/packages 再 feeds update。
src-git packages https://github.com/naoki66/packages.git^11ebc02d3914b5b3e05c964ac1d21f7e5b8cd6be
src-git luci https://github.com/immortalwrt/luci.git
src-git routing https://github.com/openwrt/routing.git
src-git telephony https://github.com/openwrt/telephony.git
src-git video https://github.com/openwrt/video.git
# PON 两个 feed 指向本仓库 fork，内容与 pbs05 上游一致。
# 固定 commit 保证构建可复现；升级 fork 时同步修改此处。
src-git pon_drivers https://github.com/DenzelVincent/openwrt-pon-drivers.git
src-git pon_userspace https://github.com/DenzelVincent/openwrt-pon-userspace.git
# lucky 仓库根下是 lucky/ 与 luci-app-lucky/ 两个包目录，可直接作 feed；固定提交避免上游改动影响编译
# 已存在的 feeds/lucky 不会自动切到固定提交，升级时先 rm -rf feeds/lucky 再 update
src-git lucky https://github.com/gdy666/luci-app-lucky.git^9449a5250c61f1aa8f16b2d8e04a9da25c26e735
#src-git targets https://github.com/openwrt/targets.git
#src-git oldpackages http://git.openwrt.org/packages.git
#src-link custom /usr/src/openwrt/custom-feed
