CONFIG_PACKAGE_libnetfilter-queue=y
# 安装 libnettle 软件包 (Nettle 底层加密库)
CONFIG_PACKAGE_libnettle=y
# 安装 libnfnetlink 软件包 (Netfilter Netlink 通信库)
CONFIG_PACKAGE_libnfnetlink=y
# 安装 libnftnl 软件包 (nftables 用户态配置库)
CONFIG_PACKAGE_libnftnl=y
# 安装 libnl-tiny 软件包 (轻量 Netlink 套接字库)
CONFIG_PACKAGE_libnl-tiny=y
# 安装 libpcap 软件包 (网络数据包捕获库)
CONFIG_PACKAGE_libpcap=y
# 安装 libpcre2 软件包 (PCRE2 正则表达式库)
CONFIG_PACKAGE_libpcre2=y
# 安装 libubox 软件包 (OpenWrt 基础工具库)
CONFIG_PACKAGE_libubox=y
# 安装 libubus 软件包 (OpenWrt ubus 客户端库)
CONFIG_PACKAGE_libubus=y
# 安装 libuci 软件包 (统一配置接口 C 库)
CONFIG_PACKAGE_libuci=y
# 安装 libuclient 软件包 (HTTP/HTTPS 客户端库)
CONFIG_PACKAGE_libuclient=y
# 安装 libucode 软件包 (ucode 脚本引擎库)
CONFIG_PACKAGE_libucode=y
# 安装 libudebug 软件包 (ucode 调试支持库)
CONFIG_PACKAGE_libudebug=y
# 安装 libustream-openssl 软件包 (uStream OpenSSL TLS 后端)
CONFIG_PACKAGE_libustream-openssl=y
# 安装 rpcd-mod-luci 软件包 (rpcd LuCI 扩展模块)
CONFIG_PACKAGE_rpcd-mod-luci=y
# 安装 rpcd-mod-rrdns 软件包 (rpcd 反向 DNS 查询模块)
CONFIG_PACKAGE_rpcd-mod-rrdns=y
# 安装 zlib 软件包 (zlib 压缩解压库)
CONFIG_PACKAGE_zlib=y
# PCRE2_JIT_ENABLED
CONFIG_PCRE2_JIT_ENABLED=y


